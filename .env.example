# Copy to .env (git-ignored) and fill in real values. Never commit .env or paste real values anywhere else.
# Precedence: shell env vars > ./.env > ~/.env. Older POCKETHOST_ADMIN_EMAIL / POCKETHOST_ADMIN_PASSWORD names also work.
POCKETHOST_URL=https://nfl-superbowl-predictions.pockethost.io
POCKETHOST_USER=you@example.com
POCKETHOST_PASSWORD=change-me

# Optional: local PostgreSQL replica (defaults match ~/personal/local-db-stack)
# LOCAL_PG_HOST=localhost
# LOCAL_PG_PORT=15432
# LOCAL_PG_USER=local_user
# LOCAL_PG_PASSWORD=
# NFL_PG_DB=nfl_superbowl_playoff_odds
# NFL_PG_SCHEMA=nfl
