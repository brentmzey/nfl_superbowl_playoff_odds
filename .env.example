# Copy to .env (git-ignored) and fill in real values. Never commit .env or paste real values anywhere else.
# Precedence: shell env vars > ./.env > ~/.env. Older POCKETHOST_ADMIN_EMAIL / POCKETHOST_ADMIN_PASSWORD names also work.
POCKETHOST_URL=https://your-instance.pockethost.io
POCKETHOST_USER=you@example.com
POCKETHOST_PASSWORD=change-me
