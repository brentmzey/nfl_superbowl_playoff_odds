    {
        "id": "s_latest_team_outlooks",
        "name": "s_latest_team_outlooks",
        "type": "view",
        "listRule": "",
        "viewRule": "",
        "viewQuery": "SELECT o.id,\n       o.str_team_code,\n       t.str_team_name,\n       t.str_conference,\n       t.str_division,\n       r.str_run_id,\n       r.dt_run_date,\n       r.int_season_year,\n       r.int_through_week,\n       o.int_wins,\n       o.int_losses,\n       o.int_ties,\n       o.dbl_elo_rating,\n       o.dbl_projected_wins,\n       o.dbl_division_prob,\n       o.dbl_playoff_prob,\n       o.dbl_divisional_prob,\n       o.dbl_conference_prob,\n       o.dbl_superbowl_prob,\n       o.dbl_champion_prob,\n       o.int_champion_rank,\n       o.json_seed_odds\nFROM o_team_outlooks o\nJOIN m_simulation_runs r ON r.id = o.rel_run\nJOIN i_nfl_teams t ON t.id = o.rel_team\nWHERE r.str_status_code = 'ACTIVE'"
    }
